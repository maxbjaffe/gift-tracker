# ==================================
# GiftStash - Environment Variables
# ==================================

# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# ----------------------------------
# Supabase Configuration
# ----------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api

# Your Supabase project URL (safe to expose publicly)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous key (safe to expose publicly)
# This key has Row Level Security (RLS) restrictions
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key (KEEP SECRET!)
# This key bypasses RLS - only use server-side
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------
# Anthropic Claude AI
# ----------------------------------
# Get your API key from: https://console.anthropic.com/

# Required for AI gift recommendations and SMS parsing
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx

# ----------------------------------
# Twilio SMS Service
# ----------------------------------
# Get these from: https://console.twilio.com/

# Twilio Account SID
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token (KEEP SECRET!)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number in E.164 format (+1234567890)
TWILIO_PHONE_NUMBER=+15555555555

# Public webhook URL for receiving SMS
# Local development: Use ngrok (https://ngrok.com)
# Production: Your Vercel deployment URL
TWILIO_SMS_WEBHOOK_URL=https://giftstash.app/api/sms/receive

# ----------------------------------
# Application Configuration
# ----------------------------------

# Your application's public URL
# Local: http://localhost:3000
# Production: https://giftstash.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------
# PWA Configuration (Optional)
# ----------------------------------

# Enable PWA features
NEXT_PUBLIC_PWA_ENABLED=true

# Enable share target (for sharing from other apps)
NEXT_PUBLIC_PWA_SHARE_TARGET=true

# ----------------------------------
# Optional: Development Tools
# ----------------------------------

# Enable debug logging (true/false)
# DEBUG=false

# Sentry DSN for error tracking (production)
# NEXT_PUBLIC_SENTRY_DSN=

# Analytics tracking ID (production)
# NEXT_PUBLIC_GA_ID=
